<!DOCTYPE html>
<html lang="de">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= client.name %> | Studio</title>
  <link rel="stylesheet" href="/style.css">

  <%# Load custom fonts for live preview %>
  <% if (client.fonts && client.fonts.some(f => f.file)) { %>
  <style>
    <% client.fonts.forEach(function(font, i) { if (font.file) { %>
    @font-face {
      font-family: 'brand-font-<%= i %>';
      src: url('<%= font.file %>');
    }
    <% } }); %>
  </style>
  <% } %>

  <%# Load Google Fonts for brand font specimens (when no custom file is uploaded) %>
  <%
    const googleFontNames = [...new Set(
      (client.fonts || [])
        .filter(f => !f.file && f.foundryUrl && f.foundryUrl.includes('fonts.google.com'))
        .map(f => f.name)
    )];
  %>
  <% if (googleFontNames.length > 0) { %>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?<%= googleFontNames.map(n => 'family=' + encodeURIComponent(n) + ':wght@400;500;600;700').join('&') %>&display=swap" rel="stylesheet">
  <% } %>
</head>
<body>

  <nav class="project-nav" id="stickyNav">
    <div class="nav-side left" id="navLeft"></div>
    <a href="/"><img src="/Logo/CK.svg" alt="Celina K." class="nav-logo"></a>
    <div class="nav-side right" id="navRight"></div>
  </nav>

  <%# Copy toast %>
  <div id="copyToast" class="copy-toast">Kopiert!</div>

  <main class="project-main">

    <!-- Hero -->
    <div class="sub-hero">
      <div class="hero-text">
        <h1><%- client.name.replace(' ', '<br>') %>.</h1>
        <h2><%= client.category %></h2>
        <p><%= client.description %></p>
      </div>
      <div class="hero-image-wrapper">
        <% if (client.heroImage) { %>
          <img src="<%= client.heroImage %>" alt="<%= client.name %>" class="sub-hero-img">
        <% } %>
      </div>
    </div>

    <!-- Brandlook -->
    <% if (client.brandlook && client.brandlook.pdf) { %>
    <section class="project-section">
      <h3 id="brandlook" class="nav-anchor section-title">Brandlook</h3>
      <div style="text-align:center;max-width:800px;margin:0 auto;">
        <% if (client.brandlook.description) { %>
          <p style="font-size:1.2rem;margin-bottom:30px;line-height:1.6;"><%= client.brandlook.description %></p>
        <% } %>
        <a href="<%= client.brandlook.pdf %>" target="_blank" class="btn-small">Download PDF</a>
      </div>
    </section>
    <% } %>

    <!-- Logos -->
    <% if (client.logos && client.logos.length > 0) { %>
    <%
      const primaryColor = (client.colors && client.colors.length > 0) ? client.colors[0].hex : '#272727';
    %>
    <section class="project-section">
      <h3 id="logos" class="nav-anchor section-title">Logos</h3>

      <div class="logo-bg-toggle">
        <button class="bg-btn active" data-bg="white" onclick="setLogoBg('white', this)">Weiß</button>
        <button class="bg-btn" data-bg="black" onclick="setLogoBg('black', this)">Schwarz</button>
        <button class="bg-btn" data-bg="primary" onclick="setLogoBg('primary', this)"
          style="background:<%= primaryColor %>;border-color:<%= primaryColor %>;color:#fff;">
          Primär
        </button>
      </div>

      <div class="content-grid" id="logoGrid">
        <% client.logos.forEach(function(logo) { %>
        <div class="content-block">
          <h4 class="sub-title"><%= logo.title %></h4>
          <div class="logo-display-wrapper logo-bg-target" style="background:#fff;border-radius:8px;padding:20px;transition:background 0.3s;">
            <% if (logo.image) { %>
              <img
                src="<%= logo.image %>"
                data-image="<%= logo.image %>"
                data-image-dark="<%= logo.imageDark || '' %>"
                class="logo-display-img"
                alt="<%= logo.title %>">
            <% } %>
          </div>
          <div class="download-group">
            <% if (logo.svg) { %>
              <a href="<%= logo.svg %>" download class="btn-small">SVG</a>
            <% } else { %>
              <span class="btn-small btn-disabled">SVG</span>
            <% } %>
            <% if (logo.eps) { %>
              <a href="<%= logo.eps %>" download class="btn-small">EPS</a>
            <% } else { %>
              <span class="btn-small btn-disabled">EPS</span>
            <% } %>
            <% if (logo.png) { %>
              <a href="<%= logo.png %>" download class="btn-small">PNG</a>
            <% } else { %>
              <span class="btn-small btn-disabled">PNG</span>
            <% } %>
          </div>
        </div>
        <% }); %>
      </div>
    </section>
    <% } %>

    <!-- Farben -->
    <% if (client.colors && client.colors.length > 0) { %>
    <section class="project-section">
      <h3 id="farben" class="nav-anchor section-title">Farben</h3>
      <div class="color-section">
        <% client.colors.forEach(function(color) {
          const h = color.hex.replace('#','');
          const r = parseInt(h.slice(0,2),16);
          const g = parseInt(h.slice(2,4),16);
          const b = parseInt(h.slice(4,6),16);
          const rr = (r/255), gg = (g/255), bb = (b/255);
          const k = 1 - Math.max(rr,gg,bb);
          const c = k===1 ? 0 : Math.round((1-rr-k)/(1-k)*100);
          const m = k===1 ? 0 : Math.round((1-gg-k)/(1-k)*100);
          const y = k===1 ? 0 : Math.round((1-bb-k)/(1-k)*100);
          const kk = Math.round(k*100);
          const rgbStr = `${r}, ${g}, ${b}`;
          const cmykStr = `${c}, ${m}, ${y}, ${kk}`;
          const isLight = (r*0.299 + g*0.587 + b*0.114) > 180;
        %>
        <div class="color-card">
          <%# Big main circle %>
          <div class="color-main-circle" style="background:rgba(<%=r%>,<%=g%>,<%=b%>,1)"></div>
          <%# Smaller tint circles below %>
          <div class="color-sub-tints">
            <div class="color-sub-tint-wrap">
              <div class="color-sub-tint" style="background:rgba(<%=r%>,<%=g%>,<%=b%>,0.75)"></div>
              <span class="tint-label">75%</span>
            </div>
            <div class="color-sub-tint-wrap">
              <div class="color-sub-tint" style="background:rgba(<%=r%>,<%=g%>,<%=b%>,0.5)"></div>
              <span class="tint-label">50%</span>
            </div>
            <div class="color-sub-tint-wrap">
              <div class="color-sub-tint" style="background:rgba(<%=r%>,<%=g%>,<%=b%>,0.25)"></div>
              <span class="tint-label">25%</span>
            </div>
          </div>
          <%# Color info %>
          <div class="color-info">
            <% if (color.name) { %><div class="color-name-display"><%= color.name %></div><% } %>
            <div class="color-values">
              <div class="color-value-row" onclick="copyVal('<%= color.hex %>', this)" title="Klicken zum Kopieren">
                <span class="color-label">HEX</span>
                <span class="color-val"><%= color.hex %></span>
                <span class="copy-icon">⎘</span>
              </div>
              <div class="color-value-row" onclick="copyVal('rgb(<%= rgbStr %>)', this)" title="Klicken zum Kopieren">
                <span class="color-label">RGB</span>
                <span class="color-val"><%= rgbStr %></span>
                <span class="copy-icon">⎘</span>
              </div>
              <div class="color-value-row" onclick="copyVal('cmyk(<%= cmykStr %>)', this)" title="Klicken zum Kopieren">
                <span class="color-label">CMYK</span>
                <span class="color-val"><%= cmykStr %></span>
                <span class="copy-icon">⎘</span>
              </div>
            </div>
          </div>
        </div>
        <% }); %>
      </div>
    </section>
    <% } %>

    <!-- Schriften -->
    <% if (client.fonts && client.fonts.length > 0) { %>
    <section class="project-section">
      <h3 id="schriften" class="nav-anchor section-title">Schriften</h3>

      <%
        const specimenBg = (client.colors && client.colors.length > 0) ? client.colors[0].hex : '#272727';
        const sbHex = specimenBg.replace('#', '');
        const sbR = parseInt(sbHex.slice(0, 2), 16), sbG = parseInt(sbHex.slice(2, 4), 16), sbB = parseInt(sbHex.slice(4, 6), 16);
        const specimenText = (sbR * 0.299 + sbG * 0.587 + sbB * 0.114) > 180 ? '#1a1a1a' : '#ffffff';
      %>
      <div class="fonts-list">
        <% client.fonts.forEach(function(font, i) {
          let specimenFamily = null;
          if (font.file) specimenFamily = 'brand-font-' + i;
          else if (font.foundryUrl && font.foundryUrl.includes('fonts.google.com')) specimenFamily = font.name;
        %>
        <div class="font-entry">
          <div class="font-entry-meta">
            <h4 class="font-entry-name"><%= font.name %></h4>
            <% if (font.description) { %><p class="font-entry-desc"><%= font.description %></p><% } %>
            <% if (font.foundryUrl) { %><a href="<%= font.foundryUrl %>" target="_blank" class="btn-small">Zur Foundry</a><% } %>
          </div>
          <% if (specimenFamily) { %>
          <div class="font-entry-specimen" style="background:<%= specimenBg %>; color:<%= specimenText %>; font-family:'<%= specimenFamily %>', serif;">
            <div class="font-specimen-name"><%= font.name %></div>
            <div class="font-specimen-line">abcdefghijklmnopqrstuvwxyz</div>
            <div class="font-specimen-line">1234567890 &amp;#+-</div>
            <div class="font-specimen-line font-specimen-upper">ABCDEFGHIJKLMNOPQRSTUVWXYZ</div>
          </div>
          <% } else if (font.preview) { %>
          <div class="font-entry-image">
            <img src="<%= font.preview %>" alt="<%= font.name %> Vorschau">
          </div>
          <% } %>
        </div>
        <% }); %>
      </div>
    </section>
    <% } %>

    <!-- Anwendungsbeispiele -->
    <% if (client.applications && client.applications.length > 0) { %>
    <section class="project-section">
      <h3 id="anwendungen" class="nav-anchor section-title">Anwendungen</h3>
      <div class="applications-grid">
        <% client.applications.forEach(function(app) { %>
        <div class="application-item">
          <img src="<%= app.image %>" alt="<%= app.caption || '' %>">
          <% if (app.caption) { %><p class="application-caption"><%= app.caption %></p><% } %>
        </div>
        <% }); %>
      </div>
    </section>
    <% } %>

    <!-- Weiteres -->
    <% if (client.downloads && client.downloads.length > 0) { %>
    <section class="project-section" style="border-bottom:none;">
      <h3 id="weiteres" class="nav-anchor section-title">Weiteres</h3>
      <div class="content-grid">
        <% client.downloads.forEach(function(dl) { %>
        <div class="content-block">
          <h4 class="sub-title"><%= dl.title %></h4>
          <% if (dl.file) { %><a href="<%= dl.file %>" download class="btn-small">Download</a><% } %>
        </div>
        <% }); %>
      </div>
    </section>
    <% } %>

  </main>

  <footer>
    <div class="footer-content">
      <div class="copyright">&copy; Celina Kammerhofer 2026</div>
      <div class="contact-info">
        Celina Kammerhofer<br>Mandarfen 81, 6481 St. Leonhard<br>Austria<br>
        <a href="mailto:hi@celina.design">hi@celina.design</a>
      </div>
    </div>
  </footer>

  <script>
    // Nav links
    const sections = document.querySelectorAll('.nav-anchor');
    const navLeft = document.getElementById('navLeft');
    const navRight = document.getElementById('navRight');
    sections.forEach((section, index) => {
      const link = document.createElement('a');
      link.href = '#' + section.id;
      link.className = 'nav-link';
      link.innerText = section.innerText;
      link.addEventListener('click', e => {
        e.preventDefault();
        document.getElementById(section.id).scrollIntoView({ behavior: 'smooth' });
      });
      (index < 3 ? navLeft : navRight).appendChild(link);
    });

    // Copy to clipboard
    function copyVal(val, el) {
      navigator.clipboard.writeText(val).then(() => {
        const toast = document.getElementById('copyToast');
        toast.classList.add('show');
        setTimeout(() => toast.classList.remove('show'), 1800);
        el.classList.add('copied');
        setTimeout(() => el.classList.remove('copied'), 1800);
      });
    }

    // Logo background toggle
    const primaryColor = '<%= (client.colors && client.colors.length > 0) ? client.colors[0].hex : "#272727" %>';
    function setLogoBg(mode, btn) {
      document.querySelectorAll('.bg-btn').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      const bg = mode === 'white' ? '#ffffff' : mode === 'black' ? '#1a1a1a' : primaryColor;
      document.querySelectorAll('.logo-bg-target').forEach(el => el.style.background = bg);
      const showWhiteLogo = mode !== 'white';
      document.querySelectorAll('.logo-display-img').forEach(img => {
        const darkSrc = img.dataset.imageDark;
        if (showWhiteLogo && darkSrc) {
          img.src = darkSrc;
          img.style.filter = 'none';
        } else if (showWhiteLogo) {
          img.src = img.dataset.image;
          img.style.filter = 'brightness(0) invert(1)';
        } else {
          img.src = img.dataset.image;
          img.style.filter = 'none';
        }
      });
    }

    // Font live preview
    function updateFontPreviews(text) {
      document.querySelectorAll('.font-live-preview').forEach(el => {
        el.textContent = text || 'Das ist eine Vorschau';
      });
    }
  </script>

</body>
</html>
